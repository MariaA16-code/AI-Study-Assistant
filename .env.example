
# ---------- Optional tuning (defaults shown; remove the # to change) ----------

# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_TIMEOUT=30            # seconds for chat answers
# GEN_TIMEOUT=60            # seconds per question-generation call
# LLM_RETRIES=1             # extra tries per provider, chat answers
# GEN_RETRIES=0             # extra tries per provider, question generation
# LLM_RETRY_DELAY=1.0       # seconds between tries (grows each time)
# GEN_EXTRA_ROUNDS=4        # extra tries to reach the requested question count
# GEN_EXTRA_CANDIDATES=3    # spare questions requested per call
# MAX_QUESTIONS=20          # most questions one request can ask for
# TOP_K=5                   # passages used to answer a chat question
# MIN_SCORE=0.50            # minimum similarity for an answer to count as found
# SUMMARY_PASSAGES=14       # passages used when summarising a document
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# CHROMA_DIR=               # where document vectors are stored (default: chroma_db/ in the project root)
#OCR_MAX_IMAGES=60            #optional
# VISION_ENABLED=True       # Gemini describes pictures, diagrams and figure pages; False = OCR only, nothing leaves your PC
# VISION_MAX_IMAGES=10      # most pictures described per DOCX
# VISION_MAX_PAGES=20       # most figure pages described per PDF
# VISION_DPI=110            # page render quality for PDF figure pages
# VISION_WORKERS=3          # pictures described at the same time
# VISION_TIMEOUT=40         # seconds per picture
# VISION_MODEL=             # model for pictures; empty = GEMINI_MODEL
# VISION_FALLBACK_MODEL=    # tried once when the main vision model fails or is busy