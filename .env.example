# Copy this file to .env in the project root (same folder as README.md) and fill it in.
# Do NOT write a comment on the same line as a value: put comments on their own line.

# ---------- Required ----------

# A long random string. Make one with the command in README step 3.
SECRET_KEY=
# Must be True, or the backend rejects every request.
DEBUG=True

# ---------- AI providers (set at least one key) ----------

# Which provider is tried first: gemini or groq. The other one is the fallback.
LLM_PROVIDER=gemini
# Needed for chat and quizzes with Gemini, and for reading pictures and diagrams (vision).
GEMINI_API_KEY=
GROQ_API_KEY=

# ---------- Optional tuning (defaults shown; remove the # at the start of a line to change one) ----------

# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b

# Seconds for chat answers
# LLM_TIMEOUT=30
# Seconds per question-generation call
# GEN_TIMEOUT=60
# Extra tries per provider, chat answers
# LLM_RETRIES=1
# Extra tries per provider, question generation
# GEN_RETRIES=0
# Seconds between tries (grows each time)
# LLM_RETRY_DELAY=1.0
# Extra tries to reach the requested question count
# GEN_EXTRA_ROUNDS=4
# Spare questions requested per call
# GEN_EXTRA_CANDIDATES=3
# Most questions one request can ask for
# MAX_QUESTIONS=20
# Passages used to answer a chat question
# TOP_K=5
# Minimum similarity for an answer to count as found
# MIN_SCORE=0.50
# Passages used when summarising a document
# SUMMARY_PASSAGES=14
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# Where document vectors are stored (default: chroma_db/ in the project root)
# CHROMA_DIR=

# ---------- OCR (reads scanned PDF pages; fallback for pictures) ----------

# OCR_ENABLED=True
# Higher = more accurate but slower
# OCR_DPI=200
# Most scanned pages read per file
# OCR_MAX_PAGES=150
# Most pictures read per DOCX
# OCR_MAX_IMAGES=60

# ---------- Vision (Gemini describes pictures, diagrams and figure pages) ----------

# False = OCR only, nothing leaves your computer
# VISION_ENABLED=True
# Model for pictures. Empty = use GEMINI_MODEL. It must be a model your own key can use.
# VISION_MODEL=
# Tried once when the main vision model fails or is busy. Must also work with your key.
# VISION_FALLBACK_MODEL=
# Most pictures described per DOCX
# VISION_MAX_IMAGES=10
# Most figure pages described per PDF
# VISION_MAX_PAGES=20
# Page render quality for PDF figure pages
# VISION_DPI=110
# Pictures described at the same time
# VISION_WORKERS=3
# Seconds per picture
# VISION_TIMEOUT=40
